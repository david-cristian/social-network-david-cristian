<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.DuckController"
            prefHeight="600.0" prefWidth="800.0">

    <center>
        <VBox>
            <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tableColumnUsername" text="Username" prefWidth="150.0"/>
                    <TableColumn fx:id="tableColumnEmail" text="Email" prefWidth="200.0"/>
                    <TableColumn fx:id="tableColumnType" text="Type" prefWidth="150.0"/>
                    <TableColumn fx:id="tableColumnSpeed" text="Speed" prefWidth="100.0"/>
                    <TableColumn fx:id="tableColumnStamina" text="Stamina" prefWidth="100.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Pagination fx:id="pagination" pageCount="1" />
    </bottom>

</BorderPane>