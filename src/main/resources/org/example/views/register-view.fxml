<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" prefHeight="650.0" prefWidth="480.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.RegisterController"
            stylesheets="@/css/style.css">

    <VBox alignment="TOP_CENTER" spacing="15.0">
        <padding><Insets top="20" bottom="20" left="20"/></padding>
        <Label text="Create new account" styleClass="header-label"/>
        <Separator/>

        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
            <Button fx:id="btnLeft" text="◀" onAction="#onSwitchLeft" styleClass="arrow-button"/>

            <Label fx:id="userTypeLabel" text="Duck" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-min-width: 120px; -fx-alignment: CENTER; -fx-text-fill: #2c3e50;"/>

            <Button fx:id="btnRight" text="▶" onAction="#onSwitchRight" styleClass="arrow-button"/>
        </HBox>

        <GridPane vgap="15" hgap="10">
            <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1" alignment="CENTER_RIGHT">
                <PasswordField fx:id="passwordField" promptText="Password" style="-fx-padding: 5 30 5 5;"/>
                <TextField fx:id="passwordTextField" promptText="Password" visible="false" managed="false" style="-fx-padding: 5 30 5 5;"/>
                <ToggleButton fx:id="togglePasswordBtn" text="👁" onAction="#onTogglePassword"
                              style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: gray; -fx-font-size: 14px;"
                              StackPane.alignment="CENTER_RIGHT">
                    <padding><Insets right="5"/> </padding>
                </ToggleButton>
            </StackPane>
            <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <Separator/>

    <VBox fx:id="duckFieldsContainer" spacing="15" style="-fx-background-color: #e8f5e9; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #c8e6c9; -fx-border-radius: 8;">
        <Label text="Duck fields" style="-fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>

        <GridPane vgap="10" hgap="10">
            <Label text="Duck type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="duckTypeComboBox" prefWidth="150" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Speed:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="speedField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Stamina:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="staminaField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

        <VBox fx:id="personFieldsContainer" spacing="10" managed="false" visible="false" style="-fx-background-color: #e3f2fd; -fx-padding: 10; -fx-background-radius: 5;">
            <Label text="Person Fields" style="-fx-font-weight: bold"/>

            <GridPane vgap="10" hgap="10">
                <Label text="First Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="lastNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Last Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Occupation:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="occupationField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Empathy (0-1000):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="empathyField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Birthday (YYYY-MM-DD):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="birthdayPicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Button text="Register" onAction="#onRegister" defaultButton="true" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Cancel" onAction="#onCancel"/>
        </HBox>
    </VBox>
</ScrollPane>