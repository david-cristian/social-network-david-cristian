<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.MainController"
            prefHeight="600.0" prefWidth="900.0"
            stylesheets="@/css/style.css">

    <top>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: #ddd;">
            <padding><Insets top="5" right="10" bottom="5" left="10"/></padding>
            <Label fx:id="userLabel" text="Not logged in"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="All ducks">
                <fx:include fx:id="duck" source="duck-view.fxml"/>
            </Tab>

            <Tab fx:id="tabFriends" text="Friends and Chat" closable="false">
                <content>
                    <SplitPane dividerPositions="0.3" orientation="HORIZONTAL">
                        <items>
                            <AnchorPane minHeight="0.0" minWidth="0.0">
                                <children>
                                    <VBox spacing="10" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">

                                        <Label text="My friends" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                                        <ListView fx:id="friendsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #e0e0e0;"/>

                                        <Separator/>

                                        <Label text="Add friend:" style="-fx-font-size: 11px; -fx-text-fill: gray;"/>
                                        <HBox spacing="5">
                                            <TextField fx:id="friendUsernameField" promptText="Username..." HBox.hgrow="ALWAYS"/>
                                            <Button text="+" onAction="#onAddFriend" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                                        </HBox>

                                        <Button text="Remove selected friend" onAction="#onRemoveFriend" maxWidth="Infinity" style="-fx-background-color: #ffcccc; -fx-text-fill: red;"/>
                                    </VBox>
                                </children>
                            </AnchorPane>

                            <AnchorPane minHeight="0.0" minWidth="0.0">
                                <children>
                                    <VBox spacing="10" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">

                                        <Label text="Chat" style="-fx-font-weight: bold; -fx-text-fill: #2196F3;"/>

                                        <ListView fx:id="chatListView" onMouseClicked="#onMessageSelected" VBox.vgrow="ALWAYS" style="-fx-background-color: #f5f5f5;"/>

                                        <Label fx:id="replyLabel" text="Reply to: ..." visible="false" style="-fx-background-color: #e0e0e0; -fx-padding: 5; -fx-background-radius: 5; -fx-font-style: italic;"/>

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <TextField fx:id="messageInput" promptText="Send message..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 15;"/>
                                            <Button text="Send" onAction="#onSendMessage" defaultButton="true" style="-fx-background-radius: 15; -fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                        </HBox>

                                    </VBox>
                                </children>
                            </AnchorPane>
                        </items>
                    </SplitPane>
                </content>
            </Tab>

            <Tab text="Stats" onSelectionChanged="#onCommunitiesTabSelected">
                <VBox spacing="20" alignment="CENTER">
                    <children>
                        <Label text="Network Stats" style="-fx-font-size: 20px;"/>
                        <HBox spacing="10" alignment="CENTER">
                            <children>
                                <Label text="Number of communities: "/>
                                <Label fx:id="communitiesCountLabel" text="-" style="-fx-font-weight: bold"/>
                            </children>
                        </HBox>
                        <VBox spacing="5" alignment="CENTER">
                            <children>
                                <Label text="Most social community:"/>
                                <ListView fx:id="mostSocialCommunityList" prefHeight="200" maxWidth="300"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </Tab>

            <Tab fx:id="tabSettings" text="Settings">
                <VBox spacing="20" alignment="CENTER">
                    <children>
                        <Label text="Risky Zone" textFill="red"/>
                        <Button text="DELETE ACCOUNT" onAction="#onDeleteAccount" style="-fx-background-color: red; -fx-text-fill: white;"/>
                    </children>
                </VBox>
            </Tab>

            <Tab fx:id="tabNotifications" text="Notifications">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Pending requests" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <ListView fx:id="requestListView" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>